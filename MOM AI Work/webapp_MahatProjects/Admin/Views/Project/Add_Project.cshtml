<script>
	var video_uploaduploaded_attachments=[];
	 
</script>
    @if (Model != null)
    {
        if(Model.video_upload != null && Model.video_upload.ToString() != "")
        {
        <script>
             video_uploaduploaded_attachments= "@Model.video_upload".split('|').filter(Boolean);
			$("#video_upload_existing").val("@Model.video_upload")
        </script>
        }
    }
 
<script>
    
   
    var fileInputvideo_upload = document.getElementById('video_upload');
    var filesTabvideo_upload = $('#video_uploadfilesTab');
    var uploadernamevideo_upload = document.querySelector(".video_uploadfilebtn");
    var video_uploadselectedFiles = [];
    var video_uploadexistingFiles = video_uploaduploaded_attachments;
    renderExistingFileListOfvideo_upload();
    updateFileCountofvideo_upload();
	

	fileInputvideo_upload.addEventListener('change', function (e) {
		var files = e.target.files;

		// Append the newly selected files to the existing video_uploadselectedFiles array
		video_uploadselectedFiles.push(...files);


		// Render the file list
		renderFileListofvideo_upload();

		 

		// Update the file count
		updateFileCountofvideo_upload();
	});
	function renderExistingFileListOfvideo_upload() {
	 	// Remove all <tr> elements with the class name existingFile
		filesTabvideo_upload.find('tr.existingFile').remove();


		// Render the updated file list
		for (var i = 0; i < video_uploadexistingFiles.length; i++) {
			var file = video_uploadexistingFiles[i];

			var fileName = file;
			var icon_Class = getIconClass(fileName);
              var filedisplayname = fileName.substring(fileName.lastIndexOf('/') + 1);
			                                                                     
			var row = $('<tr>').attr('id', 'filevideo_upload' + i).attr('class', 'existingFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '"/>'));
            row.append($('<td>').addClass('cont_lst').html('<a href="' + fileName + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + filedisplayname + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delexistingvideo_upload' + i + '"><img src="' + vBaseurl + '/images/delete.png"></span>'));

			filesTabvideo_upload.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteExistingEventvideo_upload(i);
		}
	}

	function renderFileListofvideo_upload() {
		// Remove all <tr> elements with the class name newFile
		filesTabvideo_upload.find('tr.newFile').remove();

		// Render the updated file list
		for (var i = 0; i < video_uploadselectedFiles.length; i++) {
			var file = video_uploadselectedFiles[i];

			var fileName = file.name;
			var icon_Class = getIconClass(fileName);

			var row = $('<tr>').attr('id', 'filevideo_upload' + i).attr('class', 'newFile');
			row.append($('<td>').addClass('ico_lst').html('<img src="' + vBaseurl + '' + icon_Class + '"/>'));
			row.append($('<td>').addClass('cont_lst').html('<a href="' + URL.createObjectURL(file) + '" target="_blank" id="' + fileName + '" class="filedisplay" title="' + fileName + '"><span>' + fileName + '</span></a>'));
			row.append($('<td>').addClass('delete_lst').html('<span class="btn btn-sm deleteAttach delvideo_upload' + i + '"><img src="' + vBaseurl + '/images/delete.png"></span>'));

			filesTabvideo_upload.append(row);

			// Bind the click event for the delete button using a function
			bindDeleteEventvideo_upload(i);
		}
	}

	function bindDeleteEventvideo_upload(index) {
		$(".delvideo_upload" + index).click(function () {
			// Remove the file from the selected files array
			video_uploadselectedFiles.splice(index, 1);

			// Re-render the file list
			renderFileListofvideo_upload();

			// Update the file count
			updateFileCountofvideo_upload();
		});
	}
	function bindDeleteExistingEventvideo_upload(index) {
		$(".delexistingvideo_upload" + index).click(function () {
			// Remove the file from the selected files array
			video_uploadexistingFiles.splice(index, 1);
			
			$("#video_upload_existing").val(video_uploadexistingFiles.join('|'))
			
			// Re-render the file list
			renderExistingFileListOfvideo_upload();

			// Update the file count
			updateFileCountofvideo_upload();
		});
	}
	function updateFileCountofvideo_upload() {
		// Display the file count
		uploadernamevideo_upload.innerHTML = video_uploadselectedFiles.length + video_uploadexistingFiles.length + ' files selected';
		 
	}



</script>

			
			
			
			
